# Output configuration
input * xkb_layout "fr"
input * xkb_variant "oss"
default_border pixel 1
gaps inner 5

input type:touchpad {
	events disabled_on_external_mouse
}

# Bindings
set $mod Mod4

bindsym $mod+Shift+c reload
bindsym $mod+l exec swaylock -c "000000" -l -k 
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit now?' -b 'Yes' 'swaymsg exit'
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen

bindsym $mod+ampersand workspace 1
bindsym $mod+eacute workspace 2
bindsym $mod+quotedbl workspace 3
bindsym $mod+apostrophe workspace 4
bindsym $mod+parenleft workspace 5
bindsym $mod+minus workspace 6

bindsym $mod+Shift+ampersand move container to workspace 1
bindsym $mod+Shift+eacute move container to workspace 2
bindsym $mod+Shift+quotedbl move container to workspace 3
bindsym $mod+Shift+apostrophe move container to workspace 4
bindsym $mod+Shift+parenleft move container to workspace 5
bindsym $mod+Shift+minus move container to workspace 6


bindsym $mod+Return exec ghostty
bindsym $mod+q exec firefox
bindsym $mod+r exec tofi-drun --drun-launch=true
set $screenshots_dir ~/screenshots
bindsym $mod+p exec sway-screenshot -m window -o $screenshots_dir
bindsym $mod+Shift+p exec sway-screenshot -m region -o $screenshots_dir

# menubar
exec waybar
exec waypaper --random
exec ~/bin/choose-random-helix-theme
exec mako
